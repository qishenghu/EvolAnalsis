#!/bin/bash
# =============================================================================
# CATALYST 双试点 + 新域学生 utility 合并作业(2026-08-08,4×H200 单节点)
# 前身 45382/45383 被调度到同一节点,vLLM 端口相撞、Ray 运行时互踩双双阵亡。
# 教训固化:①一节点一个作业,内部全资源自管;②端口全错开
#   GPU0 = AF 试点 vLLM :8000    GPU1 = WS 试点 vLLM :8001
#   GPU2 = SW utility vLLM :8010 GPU3 = DS utility vLLM :8011
#   栈:AF 36001/8081, WS 36003/8083, SW 26004/8084, DS 25011/8086(互不重叠)
# ③环境栈串行启动 + 失败自动拽 envservice 日志尾 + 重试一次
# 内容 = run_catalyst_pilots.pbs(五臂)∪ run_newdomain_student_utility.pbs
# =============================================================================
#PBS -N cat_util
#PBS -P gs_ccds_wangwy
#PBS -q gpu_as
#PBS -l select=1:ncpus=96:ngpus=4:mem=1200gb
#PBS -l walltime=24:00:00
#PBS -o /projects_vol/gp_wangwy/qisheng/duet_h200/logs/cat_util.pbs.log
#PBS -j oe

REPO=/home/qisheng001/DUET_H200/EvolAnalsis
SCRATCH=/projects_vol/gp_wangwy/qisheng/duet_h200
PD=$SCRATCH/catalyst_pilots
DATA=$PD/data
OUT=$SCRATCH/student_rollouts
STUDENT=/projects_vol/gp_wangwy/models/Qwen3.5-4B
CFG=$REPO/config/duet_paper_experiments_configs/iclr2027/collect_h200
mkdir -p $PD/pa $PD/pb "$OUT" "$SCRATCH/logs"
exec > >(tee -a "$SCRATCH/logs/cat_util.live.log") 2>&1
echo "######## CAT+UTIL start $(date '+%F %T') job=${PBS_JOBID:-?} host=$(hostname) ########"
export PYTHONUNBUFFERED=1
cd "$REPO" || exit 1
source "$REPO/env_config.sh"
duet_activate || { echo "ABORT: duet env"; exit 1; }
VLLM_PY="$CONDA_PATH/envs/${CONDA_ENV_VLLM2:-vllm2}/bin/python"
export VLLM_CACHE_ROOT="/tmp/vllm_cache_$(id -un)"
export TRITON_CACHE_DIR="/tmp/triton_cache_$(id -un)"
export TMPDIR=/tmp/duet_tmp_$(id -un); mkdir -p "$TMPDIR" "$VLLM_CACHE_ROOT" "$TRITON_CACHE_DIR"

VPIDS=()
cleanup() {
    echo "---- cleanup $(date '+%F %T') ----"
    for p in "${VPIDS[@]}"; do kill "$p" 2>/dev/null; done
    bash start_env_alfworld.sh stop 2>/dev/null || true
    bash start_env_webshop.sh stop 2>/dev/null || true
    bash start_env_sciworld.sh stop 2>/dev/null || true
    bash start_env_deepsearch.sh stop 2>/dev/null || true
}
trap cleanup EXIT

start_student() {  # $1 gpu  $2 port
    CUDA_VISIBLE_DEVICES=$1 VLLM_ENABLE_FLA_PACKED_RECURRENT_DECODE=0 \
    "$VLLM_PY" -m vllm.entrypoints.openai.api_server \
        --model "$STUDENT" --served-model-name qwen35-4b-student \
        --tensor-parallel-size 1 --max-model-len 32768 --max-num-seqs 16 \
        --gpu-memory-utilization 0.85 --port $2 \
        --reasoning-parser qwen3 \
        >> "$SCRATCH/logs/vllm_catutil_gpu$1.log" 2>&1 &
    VPIDS+=($!)
}
start_student 0 8000
start_student 1 8001
start_student 2 8010
start_student 3 8011
for port in 8000 8001 8010 8011; do
    for i in $(seq 1 90); do
        curl -sf --max-time 8 "http://127.0.0.1:$port/v1/models" >/dev/null && break
        [ $i -eq 90 ] && { echo "ABORT: vLLM :$port timeout"; exit 1; }
        sleep 10
    done
done
echo "4 student vLLMs up"

# ---- 环境栈:串行 + 失败拽日志重试一次 ----
start_stack() {  # $1 script  $2 health_port  $3 svc_log_basename
    local script=$1 port=$2 logbase=$3 try
    for try in 1 2; do
        if bash "$script" && curl -sf --max-time 30 "http://127.0.0.1:$port/docs" >/dev/null; then
            echo "stack $script OK (:$port)"
            return 0
        fi
        echo "==== stack $script attempt $try FAILED; envservice log tail: ===="
        tail -25 "$REPO/logs/${logbase}" 2>/dev/null || echo "(log empty/missing)"
        bash "$script" stop 2>/dev/null || true
        sleep 30
    done
    return 1
}
start_stack start_env_alfworld.sh   8081 alfworld_envservice.log   || { echo "ABORT: alfworld stack"; exit 1; }
start_stack start_env_webshop.sh    8083 webshop_envservice.log    || { echo "ABORT: webshop stack"; exit 1; }
start_stack start_env_sciworld.sh   8084 sciworld_envservice.log   || { echo "ABORT: sciworld stack"; exit 1; }
DS_OK=1
start_stack start_env_deepsearch.sh 8086 deepsearch_envservice.log || { echo "WARN: deepsearch stack failed — ds utility skipped"; DS_OK=0; }

export OPENROUTER_API_KEY=EMPTY
rc_ok() { [ "$1" = "0" ] || [ "$1" = "2" ]; }

# ================= 试点侧(GPU0/1)=================
python scripts/rewrite_hints.py --hints-in "$DATA/alfworld_hints.json" \
    --hints-out "$DATA/alfworld_hints_rw.json" \
    --api-base http://127.0.0.1:8000/v1 --model qwen35-4b-student --workers 8 \
    > "$SCRATCH/logs/rewrite_af.log" 2>&1 &
RW0=$!
python scripts/rewrite_hints.py --hints-in "$DATA/webshop_hints.json" \
    --hints-out "$DATA/webshop_hints_rw.json" \
    --api-base http://127.0.0.1:8001/v1 --model qwen35-4b-student --workers 8 \
    > "$SCRATCH/logs/rewrite_ws.log" 2>&1 &
RW1=$!

# ================= utility 侧(GPU2/3),与重写并行 =================
roll() {   # $1 env  $2 env_port  $3 vllm_port
    python scripts/collect_student_rollouts.py \
        --config "$CFG/$1_qwen35_4b_collect_h200.yaml" \
        --env-url "http://127.0.0.1:$2" \
        --task-file "data/$1/task_ids_1600_seed2026.txt" \
        --output "$OUT/$1_qwen35_4b_student_rollouts.jsonl" \
        --model qwen35-4b-student --api-base "http://127.0.0.1:$3/v1" \
        --api-key-env OPENROUTER_API_KEY \
        --rollouts-per-task 1 --max-attempts-per-rollout 3 \
        --max-tasks 400 --max-workers 8 --resume \
        > "$SCRATCH/logs/student_ro_$1.log" 2>&1
    echo "student_ro_$1 rc=$?"
}
roll sciworld 8084 8010 & USW=$!
if [ "$DS_OK" = "1" ]; then roll deepsearch 8086 8011 & UDS=$!; fi

wait $RW0 $RW1; echo "rewrite done"

run_env_arms() {   # $1 env  $2 env_port  $3 vllm_port
    local env=$1 eport=$2 vport=$3 rc=0
    local common="--config $CFG/${env}_qwen35_4b_collect_h200.yaml \
        --env-url http://127.0.0.1:$eport \
        --task-file $DATA/${env}_tasks120.txt \
        --expected-task-count $(grep -c . $DATA/${env}_tasks120.txt) \
        --model qwen35-4b-student --api-base http://127.0.0.1:$vport/v1 \
        --api-key-env OPENROUTER_API_KEY --max-workers 8 --resume"
    python scripts/collect_student_rollouts_hinted.py $common \
        --hint-key none \
        --output "$PD/pa/${env}_a0.jsonl" \
        --rollouts-per-task 8 --max-attempts-per-rollout 3 \
        > "$SCRATCH/logs/pa_${env}_a0.log" 2>&1; rc=$?
    rc_ok $rc || { echo "ABORT ${env} A0 rc=$rc"; return 1; }
    echo "[$env] A0 done $(date '+%T')"
    python scripts/collect_student_rollouts_hinted.py $common \
        --hints-file "$DATA/${env}_hints_rw.json" --hint-key raw \
        --output "$PD/pa/${env}_a1.jsonl" \
        --rollouts-per-task 8 --max-attempts-per-rollout 3 \
        > "$SCRATCH/logs/pa_${env}_a1.log" 2>&1; rc=$?
    rc_ok $rc || { echo "ABORT ${env} A1 rc=$rc"; return 1; }
    echo "[$env] A1 done $(date '+%T')"
    python scripts/collect_student_rollouts_hinted.py $common \
        --hints-file "$DATA/${env}_hints_rw.json" --hint-key rewritten \
        --output "$PD/pa/${env}_a2.jsonl" \
        --rollouts-per-task 8 --max-attempts-per-rollout 3 \
        > "$SCRATCH/logs/pa_${env}_a2.log" 2>&1; rc=$?
    rc_ok $rc || { echo "ABORT ${env} A2 rc=$rc"; return 1; }
    echo "[$env] A2 done $(date '+%T')"
    local tf=$SCRATCH/teacher_data/deepseek_v4_flash/${env}_dsv4flash_t1600_r1.jsonl
    local tf2=$SCRATCH/teacher_data/deepseek_v4_flash/${env}_dsv4flash_t1600_topup8.jsonl
    local tfargs="--teacher-files $tf"; [ -f "$tf2" ] && tfargs="$tfargs $tf2"
    for frac in 0.5 0.75; do
        python scripts/collect_student_takeover.py $common \
            $tfargs --entry-frac $frac \
            --output "$PD/pb/${env}_k${frac/0./}.jsonl" \
            --rollouts-per-task 4 --max-attempts-per-rollout 3 \
            > "$SCRATCH/logs/pb_${env}_k${frac/0./}.log" 2>&1; rc=$?
        rc_ok $rc || { echo "ABORT ${env} B$frac rc=$rc"; return 1; }
        echo "[$env] B$frac done $(date '+%T')"
    done
    return 0
}
run_env_arms alfworld 8081 8000 & PA=$!
run_env_arms webshop  8083 8001 & PB=$!
wait $PA; RCA=$?
wait $PB; RCB=$?
echo "pilot arms done rc_af=$RCA rc_ws=$RCB"

wait $USW 2>/dev/null
[ "$DS_OK" = "1" ] && wait $UDS 2>/dev/null
echo "utility rollouts done"

echo "---- 军规 verify-only(新域学生数据)----"
export PYTHONPATH="$REPO:${PYTHONPATH:-}"
for env in sciworld deepsearch; do
    f=$OUT/${env}_qwen35_4b_student_rollouts.jsonl
    [ -s "$f" ] || continue
    "$VLLM_PY" analysis/cll_teacher_profile.py \
        --input "$f" --config "$CFG/${env}_qwen35_4b_collect_h200.yaml" \
        --verify-only \
        --output "$REPO/analysis_outputs/cll_teacher_profile/verify_${env}_student_400.jsonl" \
        && echo "verify_${env} OK" || echo "verify_${env} FAILED"
done

echo "---- summary ----"
python - <<'EOF'
import json, glob, os
print('== CATALYST pilots ==')
for f in sorted(glob.glob('/projects_vol/gp_wangwy/qisheng/duet_h200/catalyst_pilots/p*/*.jsonl')):
    n=s=0; div=0
    for ln in open(f):
        r=json.loads(ln); n+=1; s+=int(bool(r.get('success')))
        div+=int(r.get('replay_divergence') or 0)
    extra=f'  divergence_total={div}' if '/pb/' in f else ''
    print(f'{f.split("catalyst_pilots/")[1]:24s} n={n:5d} success={s:4d} SR={s/max(n,1):.1%}{extra}')
print('== new-domain student pools ==')
for env in ['sciworld','deepsearch']:
    p=f"/projects_vol/gp_wangwy/qisheng/duet_h200/student_rollouts/{env}_qwen35_4b_student_rollouts.jsonl"
    if not os.path.exists(p): print(env,'(no output)'); continue
    n=s=0
    for ln in open(p):
        r=json.loads(ln); n+=1; s+=int(bool(r.get('success')))
    print(f'{env}: n={n} success={s} SR={s/max(n,1):.1%}')
EOF
echo "######## CAT+UTIL END rc_af=$RCA rc_ws=$RCB $(date '+%F %T') ########"
[ $RCA -eq 0 ] && [ $RCB -eq 0 ] && exit 0 || exit 1
